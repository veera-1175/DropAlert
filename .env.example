# Scheduling
CHECK_INTERVAL_HOURS=24
CLOUD_MODE=false
CLAIM_ENABLED=true
MIN_DEAL_PERCENT=95
GAMERPOWER_TYPES=game
GAMERPOWER_PLATFORMS=steam,gog,ubisoft,origin,android,ios

# F2P — permanent free games (Add to Library on store page)
F2P_FETCH=true
F2P_STEAM_PAGES=15
F2P_STEAM_COUNT=50
F2P_STEAM_VERIFY=true
F2P_STEAM_WORKERS=8
STEAM_GIVEAWAY_PAGES=3
STEAM_FETCH_GIVEAWAYS=true
F2P_EPIC_COUNT=80

# Email
NOTIFY_EMAIL=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_TO=your@gmail.com

# Browser — headless; profiles in %LOCALAPPDATA%\DropAlert\
BROWSER_HEADLESS=true
BROWSER_CHANNEL=chrome
LOGIN_TIMEOUT_MINUTES=15
LOGIN_STORES=epic,steam,gog
EPIC_USE_CDP=true
EPIC_CDP_PORT=9222

DATABASE_PATH=./data/games.db
WEB_PORT=5050
WEB_REFRESH_MINUTES=30
OWNER_EMAIL=your@gmail.com
